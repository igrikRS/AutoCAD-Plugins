<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!--
      Путь можно переопределить при сборке:
      msbuild LayoutsFromModel.sln /p:SpdsGraphicsDir="C:\Program Files\CSoft\СПДС GraphiCS 2023 x64\mg141x64"
    -->
    <SpdsGraphicsVersion Condition="'$(SpdsGraphicsVersion)' == ''">2023</SpdsGraphicsVersion>
    <SpdsGraphicsDir Condition="'$(SpdsGraphicsDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\SPDS\$(SpdsGraphicsVersion)\mapimgd.dll')">$(MSBuildThisFileDirectory)..\SPDS\$(SpdsGraphicsVersion)</SpdsGraphicsDir>
    <SpdsGraphicsDir Condition="'$(SpdsGraphicsDir)' == '' And Exists('$(ProgramW6432)\CSoft\СПДС GraphiCS 2024 x64\mg141x64\mapimgd.dll')">$(ProgramW6432)\CSoft\СПДС GraphiCS 2024 x64\mg141x64</SpdsGraphicsDir>
    <SpdsGraphicsDir Condition="'$(SpdsGraphicsDir)' == '' And Exists('$(ProgramW6432)\CSoft\СПДС GraphiCS 2023 x64\mg141x64\mapimgd.dll')">$(ProgramW6432)\CSoft\СПДС GraphiCS 2023 x64\mg141x64</SpdsGraphicsDir>
    <SpdsGraphicsDir Condition="'$(SpdsGraphicsDir)' == '' And Exists('$(ProgramW6432)\CSoft\СПДС GraphiCS 2021 x64\mg141x64\mapimgd.dll')">$(ProgramW6432)\CSoft\СПДС GraphiCS 2021 x64\mg141x64</SpdsGraphicsDir>
    <SpdsGraphicsDir Condition="'$(SpdsGraphicsDir)' == '' And Exists('$(ProgramW6432)\CSoft\СПДС GraphiCS 2021 x64 для AutoCAD\mg141x64\mapimgd.dll')">$(ProgramW6432)\CSoft\СПДС GraphiCS 2021 x64 для AutoCAD\mg141x64</SpdsGraphicsDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(SpdsGraphicsDir)' != ''">
    <Reference Include="MapiBaseTypes">
      <HintPath>$(SpdsGraphicsDir)\mapibasetypes.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="mapimgd">
      <HintPath>$(SpdsGraphicsDir)\mapimgd.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <Target Name="WarnIfSpdsGraphicsSdkIsMissing"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(SpdsGraphicsDir)' == ''">
    <Warning Text="Библиотеки MultiCAD не найдены. Установите СПДС GraphiCS/Enabler или задайте MSBuild-свойство SpdsGraphicsDir." />
  </Target>
</Project>
