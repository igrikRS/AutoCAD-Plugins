<Window x:Class="LayoutsFromModel.LayoutsCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание листов"
        Width="320"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="270" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="23" />
        </Style>
    </Window.Resources>

    <Border Margin="6" BorderBrush="Black" BorderThickness="1">
        <StackPanel Margin="10" HorizontalAlignment="Center">
            <Button Content="Автоматический выбор блоков"
                    Style="{StaticResource MainButtonStyle}"
                    Click="OnAutomaticBlocksClick" />
            <Button Content="Автоматический выбор форматок СПДС"
                    Style="{StaticResource MainButtonStyle}"
                    Click="OnAutomaticSpdsFormatsClick" />
            <Button Content="Ручной выбор блоков/форматок СПДС"
                    Style="{StaticResource MainButtonStyle}"
                    Click="OnManualBlocksClick" />
            <Button Content="Ручной выбор рамкой"
                    Style="{StaticResource MainButtonStyle}"
                    Click="OnManualFrameClick" />

            <Grid Width="270" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Настройки"
                        Style="{StaticResource SmallButtonStyle}"
                        Click="OnSettingsClick" />
                <Button Grid.Column="2"
                        Content="Шаблон"
                        Style="{StaticResource SmallButtonStyle}"
                        Click="OnTemplateClick" />
            </Grid>

            <Button Content="Отмена"
                    Width="100"
                    Height="23"
                    IsCancel="True" />
        </StackPanel>
    </Border>
</Window>
